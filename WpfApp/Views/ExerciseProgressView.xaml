<UserControl x:Class="WpfApp.Views.ExerciseProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="16">

        <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Next Expected unten -->
        <StackPanel x:Name="ExpectedPanel" DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Next Expected: " FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="ExpectedValue" FontSize="14"/>
        </StackPanel>

        <!-- No Data Message -->
        <TextBlock x:Name="NoDataMessage" Text="No records available for this exercise."
                   FontSize="14" Visibility="Collapsed" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Hauptbereich: Links Tabelle, Rechts Chart -->
        <Grid x:Name="DataPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Tabelle: Alle Daten -->
            <DataGrid x:Name="ProgressGrid" Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,16,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" 
                        Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                    <DataGridTextColumn Header="Total Volume" 
                        Binding="{Binding TotalVolume, StringFormat='{}{0}kg'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Chart: Letzte 3 Monate -->
            <lvc:CartesianChart x:Name="ProgressChart" Grid.Column="1"/>
        </Grid>
    </DockPanel>
</UserControl>
