<UserControl x:Class="WpfApp.Views.WorkoutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Your latest workouts" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" >
            <Button Content="EDIT WORKOUT" Click="EditWorkout_Click" Padding="12,6" Margin="4" />
            <Button Content="VIEW WORKOUT" Click="ViewWorkout_Click" Padding="12,6" Margin="4" />
            <Button Content="ADD WORKOUT" Click="AddWorkout_Click" Padding="12,6" Margin="4" />
        </StackPanel>

        <DataGrid x:Name="WorkoutsGrid" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column" SelectionChanged="WorkoutsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Workout Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Start" Binding="{Binding StartDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="*"/>
                <DataGridTextColumn Header="End" Binding="{Binding EndDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="*"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="*"/>
                <DataGridTemplateColumn Header="Action">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="DELETE" Background="#FF6B6B" Foreground="White"
                                    Click="DeleteWorkout_Click" Padding="8,2"
                                    Tag="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
